---
// P:stolinkr whole; the half in focus (data-focus on .name-scene) is lit, the other dimmed.
import { FULL_VIEWBOX, PISTOL, INKR } from '../data/marks';
---
<svg class="name-mark" viewBox={FULL_VIEWBOX} role="img" aria-label="pistolinkr">
  <g class="pistol">{PISTOL.map((d) => <path d={d} />)}</g>
  <g class="inkr">{INKR.map((d) => <path d={d} />)}</g>
</svg>
